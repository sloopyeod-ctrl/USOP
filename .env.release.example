# =============================================================================
# USOP Core v1.0 - Release Configuration
# Copy this file to .env.release and replace every CHANGE_ME value.
# Never commit .env.release.
# =============================================================================

# Customer-facing web port.
USOP_WEB_PORT=8080

# PostgreSQL - customer generated values.
POSTGRES_DB=usop
POSTGRES_USER=usop
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# Secret provider.
# RC1 currently supports: env
USOP_SECRET_PROVIDER=env

# Microsoft Entra / Microsoft Graph connector credentials.
# These are used by USOP when calling Microsoft Graph.
MS_GRAPH_TENANT_ID=CHANGE_ME
MS_GRAPH_CLIENT_ID=CHANGE_ME
MS_GRAPH_CLIENT_SECRET=CHANGE_ME

# Inbound caller authentication for the USOP API.
# Keep this configuration logically separate from MS_GRAPH_*.
USOP_AUTH_ENTRA_TENANT_ID=CHANGE_ME
USOP_AUTH_ENTRA_AUDIENCE=CHANGE_ME
USOP_AUTH_ENTRA_REQUIRED_SCOPE=access_as_user
