FROM python:3.12-alpine AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /build

RUN python -m venv /opt/usop-venv

ENV PATH="/opt/usop-venv/bin:$PATH"

COPY requirements.lock /build/requirements.lock

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r /build/requirements.lock \
    && python -m pip check \
    && python -m pip uninstall -y pip setuptools wheel

FROM python:3.12-alpine AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/usop-venv/bin:$PATH"

WORKDIR /app

RUN addgroup -S usop && adduser -S -G usop usop

COPY --from=builder /opt/usop-venv /opt/usop-venv

COPY --chown=usop:usop app /app/app
COPY --chown=usop:usop alembic.ini /app/alembic.ini
COPY --chown=usop:usop migrations /app/migrations

USER usop

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
